(include "./bar/bar.yuck")

;; --- BAR ---
(defwindow window_bar
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "0%"
                      :anchor "bottom center")
  :stacking "fg"
  :windowtype "dock"
  :exclusive true
  :wm-ignore false
  :namespace "eww-bar"
  (widget_bar))
