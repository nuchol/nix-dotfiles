;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;                    Workspaces                  ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(deflisten workspaces_data
  :initial '[{"id":1,"state":"empty"}]'
  "sh ~/.config/eww/bar/scripts/workspace.sh")

(defwidget widget_workspaces []
  (box :class "ws-container"
       :orientation "horizontal"
       :space-evenly false
       :spacing 10
       :valign "center"
       (for ws in {workspaces_data}
            (eventbox :cursor "pointer"
                      (button :class "ws ${ws.state}"
                              :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = \"${ws.id}\" })'")
                      )
            )
       )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;                      Audio                     ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(deflisten volume_mic_state
  :initial '{"audio": "unmuted", "mic": "unmuted"}'
  "sh ~/.config/eww/bar/scripts/audio.sh")

(defwidget widget_audio []
  (box :class "audio-box"
       :orientation "horizontal"
       (label :class "audio-icon ${volume_mic_state.audio}"
              :text {volume_mic_state.audio == "muted" ? "" : ""}))
)

(defwidget widget_mic []
  (box :class "mic-box"
       :orientation "horizontal"
       (label :class "mic-icon ${volume_mic_state.mic}"
              :text {volume_mic_state.mic == "muted" ? "" : ""}))
)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;                 Notifications                  ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defpoll notif_state :interval "2s"
  :initial '{"icon": "󰂚", "class": "empty", "count": 0}'
  "sh ~/.config/eww/bar/scripts/notifications.sh")

(defwidget widget_notification []
  (eventbox :cursor "pointer"
    (box :class "notif-box ${notif_state.class}"
         :hexpand false
         :space-evenly false
         :tooltip "${notif_state.count} Notifications"
         :halign "start"
         :width 20
         (button :onclick "dunstctl history-pop"
                 :onrightclick "dunstctl history-clear && dunstctl close-all"
                 (label :text {notif_state.icon}))
    )
  )
)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;                    Network                     ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(deflisten network_data
  :initial '{"status": "disconnected", "ssid": "Off", "signal": 0, "icon": "󰤮"}'
  "sh ~/.config/eww/bar/scripts/network.sh")

(defwidget widget_network []
  (box :class "network-container ${network_data.status == 'disconnected' ? 'is-off' :
       network_data.status == 'not-connected' ? 'wifi-low' : 'is-on'}"
       :orientation "horizontal"
       :space-evenly false
       :tooltip "${network_data.status == 'disconnected' ? 'Disconnected' :
       network_data.status == 'not-connected' ? 'Wi-Fi On (Not Connected)' :
       network_data.ssid == 'Ethernet' ? 'Ethernet Connection' :
       '${network_data.ssid} (${network_data.signal}%)'}"

       (label :class "network-icon"
              :text "${network_data.icon}")
       )
  )

